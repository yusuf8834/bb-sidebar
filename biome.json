        "src/settled-port-prompt.ts",
        "src/bb-sdk.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/server", "**/server.*", "**/ports-host", "**/ports-host.*", "**/server-*"],
                    "message": "Browser/shared modules must not import Node entries, even for types."
                  }
                ]
              }
            }
          }
        }
      }
    },
