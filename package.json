{
  "name": "bb-plugin-bb-sidebar",
  "version": "0.1.0",
  "type": "module",
  "description": "A stable bb thread sidebar with manual ordering, snooze, settle, and bulk actions. Similar to T3Code Sidebar.",
  "license": "MIT",
  "author": "Yusuf Akbulut",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yusuf8834/bb-t3sidebar.git"
  },
  "homepage": "https://github.com/yusuf8834/bb-t3sidebar#readme",
  "bugs": {
    "url": "https://github.com/yusuf8834/bb-t3sidebar/issues"
  },
  "engines": {
    "bb": ">=0.39.0",
    "bbPluginSdk": ">=0.4.8"
  },
  "bb": {
    "name": "BB Sidebar",
    "description": "Keeps bb threads in a stable, manually ordered inbox with snooze, settle, and bulk actions. Similar to T3Code Sidebar.",
    "branding": {
      "icon": "PanelLeft"
    },
    "app": "./app.tsx",
    "server": "./src/server.ts"
  },
  "keywords": [
    "bb-plugin",
    "sidebar",
    "threads",
    "inbox",
    "productivity"
  ],
  "files": [
    "dist",
    "src",
    "app.tsx",
    "tsconfig.json",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "bb plugin build",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.9.0",
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.14",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "bb-app": "0.39.0",
    "better-sqlite3": "12.10.0",
    "cron-parser": "^5.10.0",
    "hono": "^4.13.3",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.8",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.1"
  }
}
